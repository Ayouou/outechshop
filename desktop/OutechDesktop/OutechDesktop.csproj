<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 est déjà présent sur Windows 10/11 : rien à installer. -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>OUTECH</AssemblyName>
    <RootNamespace>OutechDesktop</RootNamespace>
    <Product>OUTECH</Product>
    <Company>OUTECH</Company>
    <Version>1.0.0</Version>
    <ApplicationIcon Condition="Exists('outech.ico')">outech.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- Permet de compiler net48 sans le pack de ciblage installé. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
