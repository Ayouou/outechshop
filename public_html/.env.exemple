# ---------------------------------------------------------------------------
# OUTECH — modèle de configuration.
#
# Copiez ce fichier en `.env` et renseignez les valeurs de votre hébergeur.
# `config.php` ne contient plus aucun identifiant : il lit ce fichier.
#
# Sur un poste de développement, un `.env.local` l'emporte sur `.env` — de quoi
# garder la connexion locale sans toucher à celle du serveur.
# ---------------------------------------------------------------------------

# ------------------------------------------------------------- base MySQL
# `mysql` (serveur) ou `sqlite` (version de bureau, sans serveur MySQL).
BD_PILOTE=mysql
# SQLite uniquement : dossier des fichiers .sqlite (vide = ./donnees).
BD_DOSSIER=
BD_HOTE=localhost
BD_PORT=3306
BD_BASE=outech
BD_UTILISATEUR=
BD_MOTDEPASSE=
# Uniquement si l'hébergeur impose un socket particulier.
BD_SOCKET=

# --------------------------------------------------------- multi-sociétés
# Base du registre : sociétés, abonnements, adresses publiques, journal.
# C'est là qu'on importe `install/console.sql`.
SAAS_CONSOLE=outech_console

# Préfixe des bases clientes. Chez un hébergeur qui impose le sien
# (Hostinger, cPanel : `u1234567_`, `moncompte_`), mettez-le ici.
SAAS_PREFIXE=outech_

# `true`  : la console crée elle-même la base de chaque nouvelle société.
# `false` : l'hébergeur l'interdit — la base se crée à la main dans le panneau,
#           et son nom se saisit dans le dossier de la société.
SAAS_CREATION_BASES=true

# ---------------------------------------------------------------- réglages
FUSEAU=Africa/Casablanca

# `true` affiche les erreurs PHP en clair : développement uniquement.
DEBOGAGE=false
